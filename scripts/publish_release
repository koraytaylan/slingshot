#!/bin/sh
# Publish a release the operator has verified, from the operator's machine.
#
# Nothing in this repository's automation can publish. A job that could create a
# release could also push to a branch, because the provider has no permission
# that separates the two, so the release workflow ends at evidence and this is
# the step that turns evidence into something a stranger can download.
#
# Every archive is authenticated before anything is uploaded, offline, against
# the trust root committed here. The digest the rows built from is named by the
# caller rather than read out of the evidence: a verifier that took its
# expectations from the thing it verifies is not checking anything. The tag is
# held to the version the workspace declares by the same script the release
# workflow runs, so that rule lives in one place.
#
# The archives and their attestation bundles are published together. A bundle
# nobody can reach is a claim nobody can check.

set -eu

# An option and the value beside it are two arguments.
OPTION_AND_VALUE=2

RELEASE_TAG=''
EVIDENCE_DIRECTORY=''
MANIFEST=Cargo.toml
PLATFORM_AUTHORITY=support/platforms.toml
NOTES_PATH=release-notes/RELEASE_NOTES.md
ACCEPTANCE_PATH=release-acceptance/acceptance.json
BUNDLE_NAME=attestation.jsonl
EVIDENCE_NAME=evidence.toml
TAG_REFERENCE=tag

report_stage() {
    printf '\n== %s ==\n' "$1"
}

report_refusal() {
    printf 'refused: %s\n' "$1" >&2
    exit 1
}

archive_suffix_for() {
    profile=$(awk -v wanted="$1" '
        $0 == "[[target]]" { matching = 0 }
        $0 == "triple = \"" wanted "\"" { matching = 1; next }
        matching && /^archive-profile = / {
            sub("^archive-profile = \\\"", ""); sub("\\\"$", ""); print; exit
        }
    ' "$PLATFORM_AUTHORITY")
    case "$profile" in
        tar.gz) printf '.tar.gz' ;;
        zip) printf '.zip' ;;
        *) report_refusal "$PLATFORM_AUTHORITY names no supported archive profile for $1" ;;
    esac
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --tag) RELEASE_TAG=$2; shift "$OPTION_AND_VALUE" ;;
        --evidence) EVIDENCE_DIRECTORY=$2; shift "$OPTION_AND_VALUE" ;;
        *) report_refusal "$1 is not an option this publisher takes" ;;
    esac
done

[ -n "$RELEASE_TAG" ] || report_refusal 'name the tag to publish'
[ -n "$EVIDENCE_DIRECTORY" ] || report_refusal 'name the directory the run was downloaded to'
[ -d "$EVIDENCE_DIRECTORY" ] || report_refusal "$EVIDENCE_DIRECTORY is not a directory"
[ -f "$MANIFEST" ] || report_refusal "$MANIFEST is not here"
[ -f "$PLATFORM_AUTHORITY" ] || report_refusal "$PLATFORM_AUTHORITY is not committed"

report_stage 'the one revision publication may mutate'
[ -z "$(git status --porcelain)" ] || report_refusal 'the verifier checkout is dirty'
HEAD_COMMIT=$(git rev-parse 'HEAD^{commit}')
LOCAL_TAG_COMMIT=$(git rev-parse "$RELEASE_TAG^{commit}") \
    || report_refusal "$RELEASE_TAG is not a local annotated or lightweight tag"
REMOTE_TAG_COMMIT=$(git ls-remote --exit-code origin "refs/tags/$RELEASE_TAG^{}" | awk 'NR == 1 { print $1 }') \
    || report_refusal "$RELEASE_TAG has no peeled remote tag"
[ "$HEAD_COMMIT" = "$LOCAL_TAG_COMMIT" ] && [ "$HEAD_COMMIT" = "$REMOTE_TAG_COMMIT" ] \
    || report_refusal 'HEAD, local tag, and remote tag do not name one commit'

NOTES=$EVIDENCE_DIRECTORY/$NOTES_PATH
[ -f "$NOTES" ] || report_refusal "$NOTES is not among the downloaded artifacts"
ACCEPTANCE=$EVIDENCE_DIRECTORY/$ACCEPTANCE_PATH
[ -f "$ACCEPTANCE" ] || report_refusal "$ACCEPTANCE is not among the downloaded artifacts"

REPOSITORY=$(sed -n 's/^repository = "\(.*\)"$/\1/p' "$MANIFEST" | head -n 1)
[ -n "$REPOSITORY" ] || report_refusal "$MANIFEST names no repository to publish to"

report_stage 'the version this tag publishes'
SLINGSHOT_RELEASE_REFERENCE_TYPE=$TAG_REFERENCE
SLINGSHOT_RELEASE_TAG=$RELEASE_TAG
export SLINGSHOT_RELEASE_REFERENCE_TYPE SLINGSHOT_RELEASE_TAG
scripts/verify_release_version

SOURCE_COMMIT=$HEAD_COMMIT
SOURCE_TREE=$(git rev-parse "$SOURCE_COMMIT^{tree}")

report_stage 'the retained acceptance decision'
cargo run --locked --quiet -p slingshot-development -- \
    verify-release-acceptance \
    --manifest "$ACCEPTANCE" \
    --reports-directory "$(dirname "$ACCEPTANCE")" \
    --source-commit "$SOURCE_COMMIT" \
    --source-tree "$SOURCE_TREE"

STAGING=$(mktemp -d)
trap 'rm -rf "$STAGING"' EXIT

report_stage 'the complete supported archive set'
EXPECTED_ROWS=$(sed -n 's/^triple = "\(.*\)"$/\1/p' "$PLATFORM_AUTHORITY" | tr '\n' ' ')
[ -n "$EXPECTED_ROWS" ] || report_refusal "$PLATFORM_AUTHORITY names no supported rows"
for TRIPLE in $EXPECTED_ROWS; do
    ROW=$EVIDENCE_DIRECTORY/release-$TRIPLE
    [ -d "$ROW" ] || report_refusal "the supported $TRIPLE row is absent"
    ARCHIVE_SUFFIX=$(archive_suffix_for "$TRIPLE")
    ARCHIVE_COUNT=$(find "$ROW" -maxdepth 1 -type f -name "*$ARCHIVE_SUFFIX" | wc -l | tr -d ' ')
    [ "$ARCHIVE_COUNT" = 1 ] || report_refusal "$ROW holds $ARCHIVE_COUNT archives rather than one"
done
for ROW in "$EVIDENCE_DIRECTORY"/release-*; do
    [ -d "$ROW" ] || continue
    TRIPLE=${ROW#"$EVIDENCE_DIRECTORY/release-"}
    case "$TRIPLE" in
        notes|acceptance) continue ;;
    esac
    case " $EXPECTED_ROWS " in
        *" $TRIPLE "*) ;;
        *) report_refusal "$ROW is not a supported release row" ;;
    esac
    ARCHIVE_SUFFIX=$(archive_suffix_for "$TRIPLE")
done

report_stage 'every archive, against the reviewed root'
set --
for ROW in "$EVIDENCE_DIRECTORY"/*; do
    [ -d "$ROW" ] || continue
    TRIPLE=${ROW#"$EVIDENCE_DIRECTORY/release-"}
    case "$TRIPLE" in
        notes|acceptance) continue ;;
    esac
    ARCHIVE_SUFFIX=$(archive_suffix_for "$TRIPLE")
    ARCHIVE=$(find "$ROW" -maxdepth 1 -type f -name "*$ARCHIVE_SUFFIX" | head -n 1)
    [ -n "$ARCHIVE" ] || continue
    # The row evidence names the cache the archive was built from; the complete
    # row-set preflight above keeps an archive from substituting for a missing
    # supported row before this per-archive provenance verification begins.
    ROW_CACHE=$(sed -n 's/^cache-sha256 = "\(.*\)"$/\1/p' "$ROW/$EVIDENCE_NAME" | head -n 1)
    [ -n "$ROW_CACHE" ] || report_refusal "$ROW/$EVIDENCE_NAME records no cache digest"
    scripts/verify_release_artifacts \
        --archive "$ARCHIVE" \
        --attestation-bundle "$ROW/$BUNDLE_NAME" \
        --evidence "$ROW/$EVIDENCE_NAME" \
        --source-commit "$SOURCE_COMMIT" \
        --cache-sha256 "$ROW_CACHE"
    # Every row names its bundle the same thing, and a release is one flat set
    # of files. Named after the archive it attests, each bundle is both nameable
    # and obvious to whoever downloads the pair.
    ARCHIVE_NAME=$(basename "$ARCHIVE")
    ATTESTATION="$STAGING/${ARCHIVE_NAME%"$ARCHIVE_SUFFIX"}.attestation.jsonl"
    cp "$ROW/$BUNDLE_NAME" "$ATTESTATION"
    set -- "$@" "$ARCHIVE" "$ATTESTATION"
done
[ "$#" -gt 0 ] || report_refusal "no release archive is under $EVIDENCE_DIRECTORY"

report_stage "publishing $RELEASE_TAG"
if gh release view "$RELEASE_TAG" --repo "$REPOSITORY" >/dev/null 2>&1; then
    gh release edit "$RELEASE_TAG" --repo "$REPOSITORY" --notes-file "$NOTES"
    gh release upload "$RELEASE_TAG" --repo "$REPOSITORY" --clobber "$@"
else
    gh release create "$RELEASE_TAG" --repo "$REPOSITORY" \
        --title "slingshot $RELEASE_TAG" --notes-file "$NOTES" --verify-tag "$@"
fi

printf '\n== %s is published, with every archive it was verified from ==\n' "$RELEASE_TAG"
