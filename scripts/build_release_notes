#!/bin/sh
# Write the changelog and this release's notes from the commit history.
#
# Every commit on a release branch carries a type and a scope naming the part of
# the product the work landed in, so the notes are a grouping of the history
# rather than a document anybody maintains by hand. cliff.toml holds the
# grouping; this holds only the tool that applies it and where the two documents
# land.
#
# The tool is pinned to one exact version and archive digest, because a
# changelog assembled by different bytes is a different document. Release-note
# assembly always authenticates its committed archive before it extracts or
# executes it; an ambient executable is not evidence of its provenance.

set -eu

DESTINATION=${1:-}
MANIFEST=support/repository-tools.toml
CONFIGURATION=cliff.toml
CHANGELOG_TOOL=git-cliff
CHANGELOG_TOOL_NAME=git-cliff
TAG_REFERENCE=tag
CHANGELOG=CHANGELOG.md
RELEASE_NOTES=RELEASE_NOTES.md

report_stage() {
    printf '\n== %s ==\n' "$1"
}

report_refusal() {
    printf 'refused: %s\n' "$1" >&2
    exit 1
}

reports_the_pinned_version() {
    "$CHANGELOG_TOOL" --version 2>/dev/null \
        | grep -qF "$CHANGELOG_TOOL_NAME $CHANGELOG_TOOL_VERSION"
}

pinned_field() {
    awk -v name="$1" -v field="$2" '
        $0 == "[[tool]]" { found = 0 }
        $0 == "name = \"" name "\"" { found = 1; next }
        found && $0 ~ "^" field " = " {
            sub("^[^=]*= \"", ""); sub("\"$", ""); print; exit
        }
    ' "$MANIFEST"
}

[ -n "$DESTINATION" ] || report_refusal 'name the directory to write the documents to'
[ -f "$CONFIGURATION" ] || report_refusal "$CONFIGURATION is not committed"
[ -f "$MANIFEST" ] || report_refusal "$MANIFEST is not committed"
CHANGELOG_TOOL_VERSION=$(pinned_field "$CHANGELOG_TOOL" version)
CHANGELOG_ARCHIVE=$(pinned_field "$CHANGELOG_TOOL" linux-archive)
CHANGELOG_DIGEST=$(pinned_field "$CHANGELOG_TOOL" linux-sha256)
[ -n "$CHANGELOG_TOOL_VERSION" ] && [ -n "$CHANGELOG_ARCHIVE" ] && [ -n "$CHANGELOG_DIGEST" ] \
    || report_refusal "$MANIFEST names no complete Linux identity for $CHANGELOG_TOOL"

report_stage 'the pinned changelog tool'
WORKING=$(mktemp -d)
trap 'rm -rf "$WORKING"' EXIT
curl --silent --show-error --fail --location --output "$WORKING/$CHANGELOG_ARCHIVE" \
    "https://github.com/orhun/git-cliff/releases/download/v$CHANGELOG_TOOL_VERSION/$CHANGELOG_ARCHIVE"
printf '%s  %s\n' "$CHANGELOG_DIGEST" "$WORKING/$CHANGELOG_ARCHIVE" | sha256sum --check --status \
    || report_refusal "$CHANGELOG_ARCHIVE does not match its manifest digest"
tar -xzf "$WORKING/$CHANGELOG_ARCHIVE" -C "$WORKING"
CHANGELOG_TOOL="$WORKING/git-cliff-$CHANGELOG_TOOL_VERSION/git-cliff"
reports_the_pinned_version || report_refusal "the authenticated archive does not report $CHANGELOG_TOOL_VERSION"

mkdir -p "$DESTINATION"

report_stage 'the changelog over the whole history'
"$CHANGELOG_TOOL" --output "$DESTINATION/$CHANGELOG"

report_stage 'the notes for what this run publishes'
if [ "${SLINGSHOT_RELEASE_REFERENCE_TYPE:-}" = "$TAG_REFERENCE" ]; then
    "$CHANGELOG_TOOL" --latest --strip header --output "$DESTINATION/$RELEASE_NOTES"
else
    "$CHANGELOG_TOOL" --unreleased --strip header --output "$DESTINATION/$RELEASE_NOTES"
fi

printf '\n== %s and %s are written to %s ==\n' "$CHANGELOG" "$RELEASE_NOTES" "$DESTINATION"
