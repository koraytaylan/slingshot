#!/bin/sh
# Verify one native row's release archive before anything trusts it.
#
# The attestation is authenticated first, offline, against the reviewed trust
# root committed in this repository. Only then is the manifest read: a manifest
# checked before its provenance is a manifest that has already been given the
# chance to say what checks it.
#
# Nothing here reaches the network, an ambient Git remote, an operating-system
# trust store, or the verifier's own built-in root.

set -eu

# An option and the value beside it are two arguments.
OPTION_AND_VALUE=2

ARCHIVE=''
BUNDLE=''
EVIDENCE=''
SOURCE_COMMIT=''
CACHE_DIGEST=''
POLICY=support/release-attestation-policy.toml

report_stage() {
    printf '\n== %s ==\n' "$1"
}

report_refusal() {
    printf 'refused: %s\n' "$1" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --archive) ARCHIVE=$2; shift "$OPTION_AND_VALUE" ;;
        --attestation-bundle) BUNDLE=$2; shift "$OPTION_AND_VALUE" ;;
        --evidence) EVIDENCE=$2; shift "$OPTION_AND_VALUE" ;;
        --source-commit) SOURCE_COMMIT=$2; shift "$OPTION_AND_VALUE" ;;
        --cache-sha256) CACHE_DIGEST=$2; shift "$OPTION_AND_VALUE" ;;
        *) report_refusal "$1 is not an option this verifier takes" ;;
    esac
done

[ -n "$ARCHIVE" ] || report_refusal 'name the archive to verify'
[ -n "$BUNDLE" ] || report_refusal 'name the attestation bundle'
[ -n "$EVIDENCE" ] || report_refusal 'name the evidence manifest'
[ -n "$SOURCE_COMMIT" ] || report_refusal 'name the exact source commit'
[ -n "$CACHE_DIGEST" ] || report_refusal 'name the cache digest this build resolved from'
[ -f "$ARCHIVE" ] || report_refusal "$ARCHIVE is not a file"
[ -f "$BUNDLE" ] || report_refusal "$BUNDLE is not a file"
[ -f "$EVIDENCE" ] || report_refusal "$EVIDENCE is not a file"
[ -f "$POLICY" ] || report_refusal "$POLICY is not committed"

ROOT=$(sed -n 's/^path = "\(.*\)"$/\1/p' "$POLICY" | head -n 1)
[ -f "$ROOT" ] || report_refusal 'the reviewed trust root is not committed'
IDENTITY=$(sed -n 's/^source-repository-uri = "\(.*\)"$/\1/p' "$POLICY")
ISSUER=$(sed -n 's/^oidc-issuer = "\(.*\)"$/\1/p' "$POLICY")

# Naming a trusted root is what makes this offline: the verifier reads the root
# committed here and asks nothing of anyone. The pinned client has no separate
# option for it, and one it does not have is one it cannot obey.
report_stage 'the attestation, offline, against the reviewed root'
# The identity a certificate carries is the workflow that signed, not the
# repository it signed for, so the repository is what the signer is held to and
# the workflow is required to be one of that repository's own.
gh attestation verify "$ARCHIVE" \
    --bundle "$BUNDLE" \
    --custom-trusted-root "$ROOT" \
    --repo "${IDENTITY#https://github.com/}" \
    --cert-identity-regex "^$IDENTITY/" \
    --cert-oidc-issuer "$ISSUER" \
    || report_refusal 'the attestation did not authenticate, so nothing it carries is evidence'

report_stage 'the archive and the evidence it carries'
cargo run --locked --quiet -p slingshot-development -- \
    verify-release-artifacts \
    --archive "$ARCHIVE" \
    --attestation-bundle "$BUNDLE" \
    --evidence "$EVIDENCE" \
    --source-commit "$SOURCE_COMMIT" \
    --cache-sha256 "$CACHE_DIGEST"

printf '\n== the archive is what it says it is ==\n'
