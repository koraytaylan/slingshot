#!/bin/sh
# The repository-local quality gate.
#
# One argument-free sequence, run in a fixed order, failing at the first check
# that does not hold. Every external tool is verified against its pinned version
# before any check runs, and the advisory database is authenticated as one exact
# snapshot before any advisory analysis reads it. Nothing here fetches, and
# build products and timing evidence are written to their configured directories.

set -eu

# Dependency acquisition belongs to the explicit preparation commands. Apply
# this to every Cargo invocation, including nested scripts and build scripts'
# Cargo children, so --locked cannot silently permit a missing crate fetch.
export CARGO_NET_OFFLINE=true

TOOL_MANIFEST=support/repository-tools.toml
DEPENDENCY_DUPLICATE_EXCEPTIONS=support/dependency-duplicate-exceptions.toml
CARGO_GATE_SCOPE='--locked --workspace --all-targets --all-features'
DIGEST_ALGORITHM_BITS=256
RUST_EDITION=2024
SCRATCH=''
TIMINGS=${SLINGSHOT_QUALITY_TIMINGS:-${CARGO_TARGET_DIR:-target}/quality-timings.tsv}

report_stage() {
    printf '\n== %s ==\n' "$1"
}

report_refusal() {
    printf 'quality: %s\n' "$1" >&2
    exit 1
}

remove_scratch() {
    if [ -n "$SCRATCH" ]; then
        rm -rf "$SCRATCH"
    fi
    remove_advisory_lock
}

remove_advisory_lock() {
    lock_name=$(sed -n 's/^lock-file-name = "\(.*\)"$/\1/p' "$TOOL_MANIFEST")
    checkout=${SLINGSHOT_RUSTSEC_ADVISORY_DATABASE_DIRECTORY:-}
    if [ -n "$lock_name" ] && [ -n "$checkout" ]; then
        rm -f "$checkout/$lock_name"
    fi
}

refuse_arguments() {
    if [ "$1" -ne 0 ]; then
        report_refusal 'this gate takes no argument; name the advisory checkout in the environment'
    fi
}

verify_repository_tools() {
    report_stage 'repository tools'
    checks="$SCRATCH/tool-checks"
    awk '
        $0 == "[[tool]]" {
            if (version != "" && quality) print version
            version = ""; quality = 1; next
        }
        /^version-check = / { version = $0 }
        /^quality-gate = false$/ { quality = 0 }
        /^\[advisory-database\]$/ { if (version != "" && quality) print version; exit }
        END { if (version != "" && quality) print version }
    ' "$TOOL_MANIFEST" | sed -n 's/^version-check = "\(.*\)"$/\1/p' > "$checks"
    if [ ! -s "$checks" ]; then
        report_refusal "$TOOL_MANIFEST names no tool to verify"
    fi
    while IFS= read -r specification; do
        probe=${specification%%|*}
        required=${specification#*|}
        if ! $probe 2>&1 | grep -qF "$required"; then
            report_refusal "no tool on this machine reports $required"
        fi
        printf 'verified %s\n' "$required"
    done < "$checks"
}

verify_advisory_snapshot() {
    report_stage 'advisory snapshot'
    if [ -z "${SLINGSHOT_RUSTSEC_ADVISORY_DATABASE_DIRECTORY:-}" ]; then
        report_refusal 'set SLINGSHOT_RUSTSEC_ADVISORY_DATABASE_DIRECTORY to the checkout to read'
    fi
    timed 'advisory authentication' cargo run --locked --quiet --package slingshot-development -- rustsec-advisory-pin
}

prepare_advisory_configuration() {
    directory_name=$(sed -n 's/^directory-name = "\(.*\)"$/\1/p' "$TOOL_MANIFEST")
    if [ -z "$directory_name" ]; then
        report_refusal "$TOOL_MANIFEST names no advisory database directory"
    fi
    mkdir -p "$SCRATCH/advisory-parent"
    ln -sfn "$SLINGSHOT_RUSTSEC_ADVISORY_DATABASE_DIRECTORY" "$SCRATCH/advisory-parent/$directory_name"
    sed "s|@ADVISORY_DATABASE_PATH@|$SCRATCH/advisory-parent|" deny.toml > "$SCRATCH/deny.toml"
}

timed() {
    measured_stage=$1
    shift
    report_stage "$measured_stage"
    "$SCRATCH/quality_stage" "$measured_stage" "$TIMINGS" "$@"
}

run_rust_gates() {
    export RUSTFLAGS="${RUSTFLAGS:-} -D warnings"
    # The minimum-version build covers default features. Clippy covers the
    # all-feature compilation configuration, so a second cargo check is redundant.
    timed 'the minimum supported version' scripts/check_minimum_supported_rust_version
    timed formatting cargo fmt --all --check
    timed 'timer formatting' rustfmt --edition "$RUST_EDITION" --check support/quality_stage.rs
    # shellcheck disable=SC2086
    timed lints cargo clippy $CARGO_GATE_SCOPE -- -D warnings
    # shellcheck disable=SC2086
    timed tests cargo test $CARGO_GATE_SCOPE
    RUSTDOCFLAGS='-D warnings' timed documentation cargo doc --locked --workspace --all-features --no-deps
}

run_repository_gates() {
    timed scripts shellcheck scripts/*
    timed 'dependency direction' cargo run --locked --quiet --package slingshot-development -- dependency-direction
    timed 'source policy' cargo run --locked --quiet --package slingshot-development -- source-policy
}

run_dependency_policy() {
    report_stage 'dependency policy'
    fuzz_toolchain=$(sed -n 's/^channel = "\(nightly-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\)"$/\1/p' fuzz/rust-toolchain.toml)
    if [ -z "$fuzz_toolchain" ]; then
        report_refusal 'fuzz/rust-toolchain.toml names no dated nightly toolchain'
    fi
    shasum -a "$DIGEST_ALGORITHM_BITS" Cargo.toml Cargo.lock fuzz/Cargo.toml fuzz/Cargo.lock fuzz/rust-toolchain.toml > "$SCRATCH/locked-graphs.before"
    render_duplicate_configuration product "$SCRATCH/product-deny.toml"
    timed 'product dependency policy' cargo deny --locked --offline --all-features check --disable-fetch --config "$SCRATCH/product-deny.toml" all
    # Fuzzing is intentionally a separately locked nightly workspace.  It is
    # not a reason for its executable dependency graph to escape the source,
    # license, advisory, yanked, or registry policy above.
    render_duplicate_configuration fuzz "$SCRATCH/fuzz-deny.toml"
    timed 'fuzz dependency policy' cargo +"$fuzz_toolchain" deny --manifest-path fuzz/Cargo.toml --locked --offline --all-features check --disable-fetch --config "$SCRATCH/fuzz-deny.toml" all
    shasum -a "$DIGEST_ALGORITHM_BITS" Cargo.toml Cargo.lock fuzz/Cargo.toml fuzz/Cargo.lock fuzz/rust-toolchain.toml > "$SCRATCH/locked-graphs.after"
    cmp -s "$SCRATCH/locked-graphs.before" "$SCRATCH/locked-graphs.after" || report_refusal 'dependency policy changed a locked graph input'
}

render_duplicate_configuration() {
    graph=$1
    destination=$2
    skip_file="$SCRATCH/$graph-duplicate-skips.toml"
    sed -n "/^\[$graph\]$/,/^\[/ { s/^cargo-deny-skip = /skip = /p; }" "$DEPENDENCY_DUPLICATE_EXCEPTIONS" > "$skip_file"
    if [ ! -s "$skip_file" ]; then
        report_refusal "$DEPENDENCY_DUPLICATE_EXCEPTIONS names no $graph duplicate exceptions"
    fi
    sed "/^allow-wildcard-paths = true$/r $skip_file" "$SCRATCH/deny.toml" > "$destination"
}

main() {
    refuse_arguments "$1"
    SCRATCH=$(mktemp -d)
    trap remove_scratch EXIT
    verify_repository_tools
    rustc --edition="$RUST_EDITION" -D warnings support/quality_stage.rs -o "$SCRATCH/quality_stage"
    mkdir -p "$(dirname "$TIMINGS")"
    printf 'stage\telapsed_seconds\texit_status\n' > "$TIMINGS"
    verify_advisory_snapshot
    prepare_advisory_configuration
    run_rust_gates
    run_repository_gates
    run_dependency_policy
    report_stage 'the repository-local gate holds'
}

main "$#"
