    },
    { "name": "empty-set", "identifiers": [], "acceptable": false },
    {
      "name": "unsorted-pair",
      "identifiers": ["sling-job-beta", "sling-job-alpha"],
      "acceptable": false
    },
    {
      "name": "duplicated-job",
      "identifiers": ["sling-job-alpha", "sling-job-alpha"],
      "acceptable": false
    },
    { "name": "empty-identifier", "identifiers": [""], "acceptable": false },
    {
      "name": "empty-identifier-among-named",
      "identifiers": ["", "sling-job-alpha"],
      "acceptable": false
    }
  ]
