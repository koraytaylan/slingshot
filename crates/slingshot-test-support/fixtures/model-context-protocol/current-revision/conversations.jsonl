# One row per conversation: what a client sends, and why.
{"name": "discovery", "intent": "a stateless client asks what this build serves before anything else", "sends": [{"id": "one", "method": "server/discover", "params": {"protocolVersion": "2026-07-28"}}]}
{"name": "ping", "intent": "the cheapest request there is, answered as a complete result", "sends": [{"id": "one", "method": "ping", "params": {"protocolVersion": "2026-07-28"}}]}
{"name": "listing-tools-and-resources", "intent": "two listings in one conversation, each answered once", "sends": [{"id": "one", "method": "tools/list", "params": {"protocolVersion": "2026-07-28"}}, {"id": "two", "method": "resources/list", "params": {"protocolVersion": "2026-07-28"}}, {"id": "three", "method": "resources/templates/list", "params": {"protocolVersion": "2026-07-28"}}]}
{"name": "an-unsupported-revision", "intent": "a client speaking neither revision is told both of them", "sends": [{"id": "one", "method": "ping", "params": {"protocolVersion": "2020-01-01"}}]}
{"name": "a-method-this-server-does-not-offer", "intent": "an unknown method is that error and no other", "sends": [{"id": "one", "method": "tools/invent", "params": {"protocolVersion": "2026-07-28"}}]}
{"name": "a-request-that-names-no-revision", "intent": "a request that says nothing about which revision it speaks is told which two exist", "sends": [{"id": "one", "method": "ping", "params": {}}, {"id": "two", "method": "ping", "params": {"protocolVersion": "2026-07-28"}}]}
{"name": "a-repeated-identifier-after-its-answer", "intent": "an identifier is reusable once its answer went out", "sends": [{"id": "one", "method": "ping", "params": {"protocolVersion": "2026-07-28"}}, {"id": "one", "method": "ping", "params": {"protocolVersion": "2026-07-28"}}]}
