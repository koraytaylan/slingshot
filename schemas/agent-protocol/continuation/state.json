{"$id":"urn:slingshot:agent:continuation:state:2","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Where a continuation token says to resume, with the original maximum page size and fixed expiry. The query and original limit are signed, so a successor cannot widen its page or move to another query.","properties":{"agent_event_store_generation":{"minimum":1,"type":"integer"},"author_target_identity_digest":{"pattern":"^[0-9a-f]{64}$","type":"string"},"expires_at_unix_milliseconds":{"minimum":0,"type":"integer"},"initial_result_limit":{"minimum":1,"type":"integer"},"position":{"minimum":0,"type":"integer"},"query_digest":{"pattern":"^[0-9a-f]{64}$","type":"string"}},"required":["agent_event_store_generation","author_target_identity_digest","expires_at_unix_milliseconds","initial_result_limit","position","query_digest"],"type":"object"}
