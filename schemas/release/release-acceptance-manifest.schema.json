{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slingshot:release:acceptance-manifest",
  "title": "One acceptance run over one source revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coordinator_row",
    "format",
    "gates",
    "isolation_sha256",
    "outcome",
    "platform_evidence_sha256",
    "provider_run",
    "rustsec_review_record_sha256",
    "source_commit",
    "source_tree"
  ],
  "properties": {
    "coordinator_row": { "type": "string", "minLength": 1 },
    "format": { "const": "slingshot.release-acceptance/1" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome", "report_sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["held", "refused"] },
          "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "isolation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcome": { "enum": ["releasable", "refused"] },
    "platform_evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_run": { "type": "string", "minLength": 1 },
    "rustsec_review_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
