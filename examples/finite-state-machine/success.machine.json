{
  "name": "success",
  "initial": "start",
  "states": {
    "start": { "on": { "run": { "target": "replicating", "effect": "replicate" } } },
    "replicating": {
      "on": {
        "replicated": { "target": "done" },
        "replication_failed": { "target": "failed" }
      }
    },
    "done": { "type": "final" },
    "failed": { "type": "final" }
  }
}
